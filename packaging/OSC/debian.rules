#!/usr/bin/make -f
%:
	dh $@ --with python3

override_dh_auto_clean:
	# Pure Python — nothing to clean

override_dh_auto_configure:
	# Pure Python — nothing to configure

override_dh_auto_build:
	# Pure Python — nothing to build

override_dh_auto_test:
	# Skip tests in package build

override_dh_auto_install:
	# 1. Verzeichnisse erstellen
	mkdir -p debian/nativmix/usr/share/nativmix
	mkdir -p debian/nativmix/usr/bin
	# NEU: Verzeichnis für Udev-Regeln erstellen
	mkdir -p debian/nativmix/lib/udev/rules.d
	
	# 2. Module & Udev-Regel kopieren
	cp -r arduino assets data lib LICENSE README.md pyproject.toml debian/nativmix/usr/share/nativmix/
	# NEU: Die Berechtigungs-Datei an den System-Pfad kopieren
	cp data/udev/99-nativmix-arduino.rules debian/nativmix/lib/udev/rules.d/
	
	# 3. Mido modular einbinden (Suche an allen OBS-Speicherorten)
	if [ -f mido-1.3.2.tar.gz ]; then tar -xf mido-1.3.2.tar.gz; \
	elif [ -f ../mido-1.3.2.tar.gz ]; then tar -xf ../mido-1.3.2.tar.gz; \
	elif [ -f /usr/src/packages/SOURCES/mido-1.3.2.tar.gz ]; then tar -xf /usr/src/packages/SOURCES/mido-1.3.2.tar.gz; fi
	
	mkdir -p debian/nativmix/usr/share/nativmix/lib
	if [ -d mido-1.3.2/mido ]; then cp -r mido-1.3.2/mido debian/nativmix/usr/share/nativmix/lib/; fi
	# Patch bundled portmidi_init.py: use find_library instead of hardcoded 'libportmidi.so'
	_PM=debian/nativmix/usr/share/nativmix/lib/mido/backends/portmidi_init.py; \
	if [ -f "$$_PM" ]; then \
		sed -i "s|dll_name = 'libportmidi.so'|import ctypes.util as _cu; dll_name = _cu.find_library('portmidi') or 'libportmidi.so'|" "$$_PM"; \
	fi
	
	# 4. Wrapper Script
	echo '#!/bin/bash' > debian/nativmix/usr/bin/nativmix
	echo 'export PYTHONPATH="/usr/share/nativmix:/usr/share/nativmix/lib:$$PYTHONPATH"' >> debian/nativmix/usr/bin/nativmix
	echo 'exec python3 -m nativmix.main "$$@"' >> debian/nativmix/usr/bin/nativmix
	chmod +x debian/nativmix/usr/bin/nativmix

	# 5. Desktop & Autostart
	mkdir -p debian/nativmix/usr/share/applications
	install -m 0644 data/nativmix.desktop debian/nativmix/usr/share/applications/
	mkdir -p debian/nativmix/etc/xdg/autostart
	install -m 0644 data/nativmix.desktop debian/nativmix/etc/xdg/autostart/

	# 6. Icons
	mkdir -p debian/nativmix/usr/share/icons/hicolor/scalable/apps
	install -m 0644 assets/icon.svg debian/nativmix/usr/share/icons/hicolor/scalable/apps/nativmix.svg
	mkdir -p debian/nativmix/usr/share/icons/hicolor/256x256/apps
	install -m 0644 assets/icon.png debian/nativmix/usr/share/icons/hicolor/256x256/apps/nativmix.png

	# 7. Systemd User Service
	mkdir -p debian/nativmix/usr/lib/systemd/user
	install -m 0644 packaging/app-nativmix.service debian/nativmix/usr/lib/systemd/user/