#!/bin/sh
# debian/python3-nativmix.postinst
#
# Post-installation maintainer script.
# Runs after the package files have been unpacked and placed on disk.
#
# Triggers update-desktop-database and gtk-update-icon-cache so that
# the application appears in the launcher and its icon is visible
# immediately after installation — without a logout or reboot.
#
# The #DEBHELPER# token below is replaced at build time with fragments
# generated by debhelper (e.g. Python byte-compilation triggers).
# It must not be removed.

set -e

case "$1" in
    configure)
        # Rebuild the desktop application database.
        # This makes the application appear in GNOME Shell, Pop!_OS launcher,
        # KDE Plasma, and any other XDG-compliant application menu.
        if command -v update-desktop-database > /dev/null 2>&1; then
            update-desktop-database -q /usr/share/applications || true
        fi

        # Rebuild the hicolor icon theme cache.
        # -q  : quiet (suppress progress output)
        # -t  : do not check for mtime (force full rebuild)
        # -f  : ignore a missing cache file (safe on first install)
        # Without this, the icon may not appear until the next login.
        if command -v gtk-update-icon-cache > /dev/null 2>&1; then
            gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor || true
        fi
        ;;

    abort-upgrade|abort-remove|abort-deconfigure)
        # Nothing to do on rollback.
        ;;

    *)
        echo "postinst called with unknown argument '$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0
