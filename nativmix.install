post_install() {
    echo "==> NATIVMIX INSTALLATION NOTES:"
    echo " "
    echo "  SERIAL ACCESS:"
    echo "     To use the hardware controller, add your user to the 'uucp' group:"
    echo "     sudo usermod -aG uucp \$USER"
    echo "     (Log out and back in for changes to take effect)"
    echo " "
    echo "  GLOBAL HOTKEYS:"
    echo "     To toggle mute via a shortcut (e.g., in KDE Plasma), use:"
    echo "     sh -c '/usr/bin/nativmix --toggle-mute [index]'"
    echo " "
    echo "     Replace [index] with the number of the fader (e.g., 0, 1, 2...)"
    echo " "
}

post_upgrade() {
    post_install
}